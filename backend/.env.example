# The only required setting: a MongoDB connection string (MongoDB Atlas free tier works)
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/geospot
# Long random string used to sign login tokens, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# On Render the blueprint (render.yaml) generates this for you.
JWT_SECRET=
PORT=3000
# Optional: password reset emails. Any SMTP provider works, e.g. a Gmail app password:
#   smtps://you%40gmail.com:<app-password>@smtp.gmail.com:465
# Without it, reset codes print to the server log in development; in production the app
# says password reset isn't set up.
SMTP_URL=
MAIL_FROM=GeoSpot <no-reply@example.com>
