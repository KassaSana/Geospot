MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/geospot
# Long random string used to sign login tokens, e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GOOGLE_MAPS_API_KEY=
PORT=3000
# Password reset emails. Any SMTP provider works, e.g. smtps://user:pass@smtp.example.com:465
# Without it, reset codes are printed to the server log (and refused when NODE_ENV=production).
SMTP_URL=
MAIL_FROM=GeoSpot <no-reply@example.com>
