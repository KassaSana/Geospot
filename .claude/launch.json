{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api-memory",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "backend", "run", "dev:memory"],
      "port": 3000
    },
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["expo", "start", "--web", "--port", "8081"],
      "port": 8081,
      "env": { "EXPO_PUBLIC_API_URL": "http://localhost:3000", "BROWSER": "none" }
    }
  ]
}
